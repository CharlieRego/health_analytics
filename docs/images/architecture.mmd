%% Source for docs/images/architecture.png
%% Rebuild: npx -y @mermaid-js/mermaid-cli -i docs/images/architecture.mmd -o docs/images/architecture.png -b white -s 2 -w 1400
flowchart LR
    A["AIHW MyHospitals API<br/><small>public hospital data</small>"]

    subgraph VPS["Linux Server + Docker"]
        direction LR
        P["Extract<br/><small>data from the API with Python</small>"]
        R[("Load: raw<br/><small>Postgres, JSONB data<br/>(untransformed)</small>")]
        D["Transform<br/><small>clean, model and test<br/>with dbt</small>"]
        M[("marts<br/><small>Postgres, transformed data</small>")]
        AU[("audit<br/><small>Postgres, execution logs</small>")]
        B["Postgres backup<br/><small>nightly, whole database,<br/>14 days kept</small>"]
        P --> R --> D --> M
        P --> AU
        D <--> AU
        AU -.-> B
    end

    H["Healthchecks.io<br/><small>emails an alert if a run<br/>fails or doesn't happen</small>"]
    PBI["Power BI Desktop<br/><small>read-only login,<br/>over an SSH tunnel</small>"]

    A -->|HTTPS| P
    P -.->|ping| H
    M --> PBI

    classDef src fill:#FFFFFF,stroke:#1F2A44,color:#1F2A44,stroke-width:1.5px
    classDef proc fill:#0F7C8C,stroke:#0F7C8C,color:#FFFFFF
    classDef store fill:#E6F2F4,stroke:#0F7C8C,color:#1F2A44,stroke-width:1.5px
    classDef out fill:#1F2A44,stroke:#1F2A44,color:#FFFFFF
    classDef ops fill:#FFF6DB,stroke:#E0A800,color:#1F2A44
    class A src
    class P,D proc
    class R,M,AU store
    class PBI out
    class H,B ops
    style VPS fill:#F4F6F9,stroke:#9AA5B1,color:#1F2A44
